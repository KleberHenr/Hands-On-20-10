import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int[] A = new int[8];
        int[] B = new int[8];

        for (int i = 0; i < 8; i++) {
            System.out.print("Digite um numero inteiro: ");
            A[i] = entrada.nextInt();

            B[i] = A[i] * 3;
        }

        System.out.println("Elementos do vetor B:");

        for (int i = 0; i < 8; i++) {
            System.out.println(B[i]);
        }

        entrada.close();
    }
}
